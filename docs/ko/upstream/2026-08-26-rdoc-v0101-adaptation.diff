diff --git a/crates/rdoc-core/src/lib.rs b/crates/rdoc-core/src/lib.rs
index 73de9d9..dcd1d35 100644
--- a/crates/rdoc-core/src/lib.rs
+++ b/crates/rdoc-core/src/lib.rs
@@ -432,6 +432,12 @@ impl<'a> SvgRenderer<'a> {
                     self.emit_elements(out, &g.children);
                     out.push_str("</g>\n");
                 }
+                // Tagged-structure ownership (v0.9.0+): draws nothing itself,
+                // so render the children in place. Artifacts (structure None)
+                // are decorative but still visible content.
+                PositionedElement::MarkedContent { children, .. } => {
+                    self.emit_elements(out, children);
+                }
                 _ => {
                     self.warnings += 1;
                 }
@@ -469,6 +475,7 @@ impl<'a> SvgRenderer<'a> {
                         r.push_hit(run);
                     }
                     PositionedElement::Group(g) => walk(r, &g.children),
+                    PositionedElement::MarkedContent { children, .. } => walk(r, children),
                     _ => {}
                 }
             }
@@ -1051,6 +1058,12 @@ fn hash_elements(elements: &[PositionedElement], h: &mut Fnv) {
                 h.f64(g.opacity);
                 hash_elements(&g.children, h);
             }
+            // Structure ownership affects nothing we draw; hash the payload
+            // so page fingerprints still track real content changes.
+            PositionedElement::MarkedContent { children, .. } => {
+                h.bytes(b"m");
+                hash_elements(children, h);
+            }
             _ => h.bytes(b"?"),
         }
     }
